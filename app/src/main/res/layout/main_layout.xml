<?xml version="1.0" encoding="utf-8"?>
<!-- 1. El DrawerLayout es el nuevo contenedor raíz -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start"
    android:focusable="true"
    android:focusableInTouchMode="true">
    
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--parte principal con la cabezera y el contenedor para fragments-->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".MainActivity">

            <FrameLayout
                android:id="@+id/cabezera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/topAppBar2"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:layout_marginTop="3dp"
                    android:background="?attr/colorSecondary"
                    style="@style/Widget.MaterialComponents.Toolbar.Primary" />

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/topAppBar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="?attr/colorPrimary"
                    app:titleCentered="true"
                    app:titleTextColor="?attr/colorOnPrimary"
                    style="@style/Widget.MaterialComponents.Toolbar.Primary" />

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/topAppBar3"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:background="?attr/colorPrimary"
                    android:layout_marginTop="3dp"
                    android:elevation="20dp"
                    android:visibility="gone"/>

            </FrameLayout>

            <!-- Contenedor del contenido (puede ser tu FragmentContainerView o un layout normal) -->
            <FrameLayout
                android:id="@+id/fragment_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/android:colorBackground">

                <!--boton giratorio principal-->
                <LinearLayout
                    android:id="@+id/opciones"
                    android:elevation="10dp"
                    android:layout_gravity="end|bottom"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/circulo_completo"
                    android:backgroundTint="?attr/colorPrimary"
                    android:gravity="center"
                    android:layout_marginRight="50dp"
                    android:layout_marginBottom="50dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/mas_blanco"/>

                </LinearLayout>
                <!--boton pedido-->
                <TextView
                    android:id="@+id/TVBotonPedido"
                    android:elevation="10dp"
                    android:layout_gravity="end|bottom"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:background="@drawable/boton1"
                    android:backgroundTint="?attr/colorOnTertiary"
                    android:gravity="center"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_marginRight="55dp"
                    android:layout_marginBottom="160dp"
                    android:text="Pedido"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"/>
                <!--boton moje-->
                <TextView
                    android:id="@+id/TVBotonMoje"
                    android:elevation="10dp"
                    android:layout_gravity="end|bottom"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:background="@drawable/boton1"
                    android:backgroundTint="?attr/colorOnTertiaryContainer"
                    android:gravity="center"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_marginRight="55dp"
                    android:layout_marginBottom="210dp"
                    android:text="Moje"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"/>
                <!--boton tiempos-->
                <TextView
                    android:id="@+id/TVBotonTiempo"
                    android:elevation="10dp"
                    android:layout_gravity="end|bottom"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:background="@drawable/boton1"
                    android:backgroundTint="?attr/colorOnTertiaryFixed"
                    android:gravity="center"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_marginRight="55dp"
                    android:layout_marginBottom="260dp"
                    android:text="Tiempo"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"/>

            </FrameLayout>

        </LinearLayout>


        <!-- contenedor mojes oculto -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/CLMojes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <!--bloque oscurecedor para el bloque mojes-->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#C4C4C4"
                android:alpha="0.5"/>
            <!--contenedor de la interfas para seleccionar los mojes y sus recetas-->
            <LinearLayout
                android:id="@+id/LLCajaMojes"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.7"
                app:layout_constraintHeight_percent="0.7"
                android:background="@drawable/bordes_algo_redondos">

                <!-- parte de arriba donde se escribe el numero de mojes-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@drawable/bordes_circulo_arriba"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnPrimary"
                        android:text="Mojes"
                        android:textSize="30sp"
                        android:layout_marginBottom="15dp"
                        android:gravity="center"/>

                    <EditText
                        android:id="@+id/cantidadMojes"
                        android:layout_width="100dp"
                        android:layout_height="35dp"
                        android:background="@drawable/edittext_border_selector"
                        android:inputType="numberDecimal"
                        android:gravity="center"
                        android:text="1"
                        android:selectAllOnFocus="true"/>

                </LinearLayout>

                <!--parte donde iran las recetas segun el archivo leido-->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/cajaRecetas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bordes_circulo_abajo">

                    </LinearLayout>

                </ScrollView>

                <!--boton de guardado-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/enviarMoje"
                        android:layout_width="120dp"
                        android:layout_height="40dp"
                        android:background="@drawable/redondo_sin_foco"
                        android:backgroundTint="?attr/colorOnTertiaryContainer"
                        android:textColor="?attr/colorOnPrimary"
                        android:gravity="center"
                        android:textSize="20dp"
                        android:text="Confirmar"/>

                </LinearLayout>


            </LinearLayout>
            <!--boton de cerrar mojes-->
            <LinearLayout
                android:id="@+id/LLBotonCerrarMojes"
                android:rotation="45"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="@drawable/circulo_completo"
                android:backgroundTint="?attr/colorPrimary"
                android:gravity="center"
                android:layout_marginRight="50dp"
                android:layout_marginBottom="50dp"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/mas_blanco"/>

            </LinearLayout>
            
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!--contenedor tiempos oculto-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/CLTiempos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!--bloque oscurecedor para el bloque tiempos-->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#C4C4C4"
                android:alpha="0.5"/>
            <!--contenedor de la interfas para crear temporizadores y sus etiquetas-->
            <LinearLayout
                android:id="@+id/LLCajaTiempos"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.7"
                app:layout_constraintHeight_percent="0.7"
                android:background="@drawable/bordes_algo_redondos"
                android:backgroundTint="?attr/colorOnTertiaryFixed">

                <!--contenedor etiquetas-->
                <LinearLayout
                    android:id="@+id/LLEtiquetas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bordes_algo_redondos">

                    <!--titulo etiquetas-->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnBackground"
                        android:text="Etiquetas"
                        android:gravity="center"
                        android:textSize="35dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="#000000"/>

                    <!--etiquetas-->
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:id="@+id/LLCajaEtiquetas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">
                            <!--etiqueta sin etiqueta-->
                            <TextView
                                android:id="@+id/TVSinEtiqueta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnBackground"
                                android:text="Sin etiqueta"
                                android:gravity="center"
                                android:textSize="22dp"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp"
                                android:clickable="true"
                                android:focusable="true"/>
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#000000"/>
                            <View
                                android:id="@+id/VBotonAgregarEtiqueta"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/agregar_simbolo"
                                android:backgroundTint="?attr/colorOnBackground"
                                android:clickable="true"
                                android:focusable="true"/>
                        </LinearLayout>
                    </ScrollView>
                </LinearLayout>

                <!--contenedor creador de temporizadores-->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <!--layout tiempo-->
                    <LinearLayout
                        android:id="@+id/LLTiempo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="50dp"
                        android:background="@drawable/bordes_redondeados_simple"
                        android:backgroundTint="?attr/android:colorBackground">

                        <TextView
                            android:id="@+id/TVHoras"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="30dp"
                            android:paddingVertical="3dp"
                            android:paddingHorizontal="10dp"
                            android:text="00"
                            android:textColor="?attr/colorOnBackground"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="30dp"
                            android:text=":"
                            android:paddingVertical="3dp"
                            android:textColor="?attr/colorOnBackground"/>
                        <TextView
                            android:id="@+id/TVMinutos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="30dp"
                            android:paddingVertical="3dp"
                            android:paddingHorizontal="10dp"
                            android:text="00"
                            android:textColor="?attr/colorOnBackground"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="30dp"
                            android:text=":"
                            android:paddingVertical="3dp"
                            android:textColor="?attr/colorOnBackground"/>
                        <TextView
                            android:id="@+id/TVSegundos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="30dp"
                            android:paddingVertical="3dp"
                            android:paddingHorizontal="10dp"
                            android:text="00"
                            android:textColor="?attr/colorOnBackground"/>

                    </LinearLayout>

                    <!--botones de numeros-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/CLBotonesTiempo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/LLTiempo"
                        android:layout_marginTop="20dp">

                        <TextView
                            android:id="@+id/TVUno"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:textSize="25dp"
                            android:text="1"
                            android:gravity="center"
                            android:background="@drawable/circulo_completo"
                            android:backgroundTint="?attr/android:colorBackground"
                            android:layout_marginTop="20dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/TVDos"
                            android:clickable="true"
                            android:focusable="true"/>
                        <TextView
                            android:id="@+id/TVDos"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:textSize="25dp"
                            android:text="2"
                            android:gravity="center"
                            android:background="@drawable/circulo_completo"
                            android:backgroundTint="?attr/android:colorBackground"
                            app:layout_constraintStart_toEndOf="@id/TVUno"
                            app:layout_constraintTop_toTopOf="@id/TVUno"
                            app:layout_constraintEnd_toStartOf="@id/TVTres"
                            android:clickable="true"
                            android:focusable="true"/>
                        <TextView
                            android:id="@+id/TVTres"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:textSize="25dp"
                            android:text="3"
                            android:gravity="center"
                            android:background="@drawable/circulo_completo"
                            android:backgroundTint="?attr/android:colorBackground"
                            app:layout_constraintStart_toEndOf="@id/TVDos"
                            app:layout_constraintTop_toTopOf="@id/TVUno"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:clickable="true"
                            android:focusable="true"/>
                        <TextView
                            android:id="@+id/TVCuatro"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:textSize="25dp"
                            android:text="4"
                            android:gravity="center"
                            android:background="@drawable/circulo_completo"
                            android:backgroundTint="?attr/android:colorBackground"
                            android:layout_marginTop="20dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/TVDos"
                            app:layout_constraintEnd_toStartOf="@id/TVDos"
                            android:clickable="true"
                            android:focusable="true"/>
                        <TextView
                            android:id="@+id/TVCinco"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:textSize="25dp"
                            android:text="5"
                            android:gravity="center"
                            android:background="@drawable/circulo_completo"
                            android:backgroundTint="?attr/android:colorBackground"
                            app:layout_constraintStart_toEndOf="@id/TVUno"
                            app:layout_constraintTop_toTopOf="@id/TVCuatro"
                            app:layout_constraintEnd_toStartOf="@id/TVTres"
                            android:clickable="true"
                            android:focusable="true"/>
                        <TextView
                            android:id="@+id/TVSeis"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:textSize="25dp"
                            android:text="6"
                            android:gravity="center"
                            android:background="@drawable/circulo_completo"
                            android:backgroundTint="?attr/android:colorBackground"
                            app:layout_constraintStart_toEndOf="@id/TVDos"
                            app:layout_constraintTop_toTopOf="@id/TVCuatro"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:clickable="true"
                            android:focusable="true"/>
                        <TextView
                            android:id="@+id/TVSiete"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:textSize="25dp"
                            android:text="7"
                            android:gravity="center"
                            android:background="@drawable/circulo_completo"
                            android:backgroundTint="?attr/android:colorBackground"
                            android:layout_marginTop="20dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/TVCuatro"
                            app:layout_constraintEnd_toStartOf="@id/TVDos"
                            android:clickable="true"
                            android:focusable="true"/>
                        <TextView
                            android:id="@+id/TVOcho"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:textSize="25dp"
                            android:text="8"
                            android:gravity="center"
                            android:background="@drawable/circulo_completo"
                            android:backgroundTint="?attr/android:colorBackground"
                            app:layout_constraintStart_toEndOf="@id/TVUno"
                            app:layout_constraintTop_toTopOf="@id/TVSiete"
                            app:layout_constraintEnd_toStartOf="@id/TVTres"
                            android:clickable="true"
                            android:focusable="true"/>
                        <TextView
                            android:id="@+id/TVNueve"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:textSize="25dp"
                            android:text="9"
                            android:gravity="center"
                            android:background="@drawable/circulo_completo"
                            android:backgroundTint="?attr/android:colorBackground"
                            app:layout_constraintStart_toEndOf="@id/TVDos"
                            app:layout_constraintTop_toTopOf="@id/TVSiete"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:clickable="true"
                            android:focusable="true"/>
                        <TextView
                            android:id="@+id/TVDobleZero"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:textSize="25dp"
                            android:text="00"
                            android:gravity="center"
                            android:background="@drawable/circulo_completo"
                            android:backgroundTint="?attr/android:colorBackground"
                            android:layout_marginTop="20dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/TVSiete"
                            app:layout_constraintEnd_toStartOf="@id/TVZero"
                            android:clickable="true"
                            android:focusable="true"/>
                        <TextView
                            android:id="@+id/TVZero"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:textSize="25dp"
                            android:text="0"
                            android:gravity="center"
                            android:background="@drawable/circulo_completo"
                            android:backgroundTint="?attr/android:colorBackground"
                            app:layout_constraintStart_toEndOf="@id/TVDobleZero"
                            app:layout_constraintTop_toTopOf="@id/TVDobleZero"
                            app:layout_constraintEnd_toEndOf="@id/TVBorrar"
                            android:clickable="true"
                            android:focusable="true"/>
                        <TextView
                            android:id="@+id/TVBorrar"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:textSize="25dp"
                            android:text="-"
                            android:gravity="center"
                            android:background="@drawable/circulo_completo"
                            android:backgroundTint="?attr/android:colorBackground"
                            app:layout_constraintStart_toEndOf="@id/TVZero"
                            app:layout_constraintTop_toTopOf="@id/TVDobleZero"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:clickable="true"
                            android:focusable="true"/>



                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--boton iniciar-->
                    <TextView
                        android:id="@+id/TVBotonIniciarTiempos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Iniciar"
                        android:background="@drawable/bordes_redondeados_simple"
                        android:backgroundTint="?attr/colorOnTertiaryContainer"
                        android:textColor="?attr/colorOnPrimary"
                        app:layout_constraintTop_toBottomOf="@id/CLBotonesTiempo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="30dp"
                        android:paddingHorizontal="10dp"
                        android:textSize="30dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <!--contenedor temporizadores guardados-->
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintTop_toBottomOf="@id/TVBotonIniciarTiempos"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/CLCajaTemporizadoresGuardados"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            
                            <androidx.constraintlayout.widget.Guideline
                                android:id="@+id/GLCajaTemporizadoresGuardados"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                app:layout_constraintGuide_percent="0.5"/>

                            <View
                                android:id="@+id/VBotonAgregarTemporizadores"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="@id/GLCajaTemporizadoresGuardados"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/agregar_simbolo"
                                android:backgroundTint="?attr/android:colorBackground"
                                android:clickable="true"
                                android:focusable="true"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </ScrollView>


                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
            <!--boton de cerrar tiempos-->
            <LinearLayout
                android:id="@+id/LLBotonCerrarTiempos"
                android:rotation="45"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="@drawable/circulo_completo"
                android:backgroundTint="?attr/colorPrimary"
                android:gravity="center"
                android:layout_marginRight="50dp"
                android:layout_marginBottom="50dp"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/mas_blanco"/>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
        
    </FrameLayout>

    <!-- 3. El menú que se deslizará (AHORA ES UN LINEARLAYOUT CON CONTENIDO) -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground">

        <!-- Cabecera del menú (opcional pero recomendada) -->
        <include layout="@layout/nav_header_main" />

        <!-- Menú Superior -->
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigation_view_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/navigation_drawer_menu_top"
            app:itemShapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Cuadrado"
            app:itemShapeAppearance="@style/ShapeAppearanceOverlay.App.Cuadrado"/>

        <!-- Espaciador que empuja el menú inferior hacia abajo -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Menú Inferior -->
        <!-- Menú Inferior (AHORA ES UN LAYOUT PERSONALIZADO) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"       android:gravity="end|center_vertical"
            android:padding="16dp">

            <!-- Icono para el Modo Oscuro -->
            <ImageView
                android:id="@+id/icon_dark_mode"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_dark_mode"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Activar modo oscuro" />

            <!-- Icono para el Modo Claro -->
            <ImageView
                android:id="@+id/icon_light_mode"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_light_mode"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Activar modo claro" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
